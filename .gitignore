# Secrets — never committed, never read by AI agents (use .env.example instead)
.env
.env.*
!.env.example

# Go (server/)
server/bin/
server/dist/
*.exe

# A server run with the default -world-dir writes its saved chunks here. Deltas only —
# the generated terrain is a function of the seed — but it is local state, not source.
/world/
server/world/

# Rust (client/)
client/target/
target/

# Editors / OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Logs and scratch
*.log

# Graphify local/cache artifacts. Keep GRAPH_REPORT.md, graph.json and graph.html trackable.
**/graphify-out/cache/
**/graphify-out/cost.json
**/graphify-out/.graphify_python
**/graphify-out/.graphify_root
**/graphify-out/manifest.json
**/graphify-out/.graphify_labels.json
**/graphify-out/.graphify_labels.json.sig
**/graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# Python bytecode (test runs)
__pycache__/
*.pyc
