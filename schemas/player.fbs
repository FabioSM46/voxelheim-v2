// =============================================================================
// player.fbs — input in, authoritative state out.
//
// This file is where the server-authoritative rule becomes a wire-level fact:
// the client sends what the player is *trying* to do, and the server sends what
// actually happened. There is deliberately no message in which a client states
// its own position, so there is no such claim for the server to validate — or
// to get wrong.
// =============================================================================

include "world.fbs";

namespace Voxelheim.Net;

/// One tick's worth of intent from a client.
///
/// Sent at `ServerWelcome.tick_rate`, not at the client's frame rate. The
/// server clamps the axes and integrates them itself; a client that sends
/// out-of-range values gains nothing.
///
/// **Decoder invariant: every float here must be finite.** This is a different
/// requirement from the range clamp, and clamping cannot satisfy it. `NaN`
/// compares false against every bound, so the usual `if v > 1 { v = 1 }` lets it
/// through untouched, and it then propagates through the integrator into a
/// position that stays `NaN` forever. The server rejects or zeroes non-finite
/// components **before** any physics runs, treating them as the malformed input
/// they are rather than as an extreme value.
table PlayerInput {
  /// The client's own tick counter. Used for ordering and staleness checks; the
  /// server never trusts it as a clock.
  client_tick: uint;

  /// Strafe intent, -1 (left) to 1 (right). Clamped server-side.
  move_x: float;

  /// Forward intent, -1 (backward) to 1 (forward). Clamped server-side.
  move_z: float;

  /// Facing, in radians. Affects the direction the movement axes are applied
  /// in, so the server needs it even though the camera is a client concern.
  yaw: float;

  /// Pitch, in radians. Carried for aiming; movement ignores it.
  pitch: float;

  /// Whether the jump control is held this tick. Whether a jump *happens* is
  /// the server's decision (it owns ground contact).
  jump: bool;
}

/// Starts, continues or cancels mining one voxel. Client -> server, and intent
/// only: the server owns hardness, elapsed progress, completion and the item
/// that breaking eventually yields.
///
/// There is no acknowledgement or rejection payload. A request the server
/// refuses is silence, and an accepted request becomes visible only through the
/// authoritative `MineProgress`, inventory and world state that follow.
///
/// Decoder invariants the server enforces on this untrusted input:
///   - `pos` absent decodes as null / `None`: a protocol error, never the origin
///   - `slot` must be < `ServerWelcome.inventory_slots`
///   - `client_tick` is ordering and staleness only, never a trusted clock
table MineRequest {
  /// The voxel whose mining control changed, in world coordinates.
  pos: BlockCoord;

  /// True while mining is active; false cancels mining at `pos`.
  active: bool;

  /// The client's own tick counter, for ordering and staleness only.
  client_tick: uint;

  /// The authoritative inventory slot the player is mining with.
  ///
  /// **Which slot, never what is in it.** The server reads its own inventory to find
  /// the item and its own table to find what that item is worth against this block; a
  /// client that named a tool would be naming its own mining speed.
  ///
  /// Appended in V8, and this was the one action that named no slot — an attack, a
  /// placement and a repair all already do. Absent decodes as `0`, which is a real
  /// hotbar slot rather than a sentinel, and that is deliberate: a client too old to
  /// send one mines with slot zero rather than being refused, and mining with the wrong
  /// implement is exactly bare hands. There is nothing a stale client can gain here.
  slot: ubyte;
}

/// Authoritative mining progress for one voxel. Server -> client.
///
/// Decoder invariants the client enforces:
///   - `pos` absent decodes as null / `None`: a protocol error, never the origin
///   - `progress` is a fraction of 255 (`0` is no progress, `255` is complete),
///     never a tick count or a duration
table MineProgress {
  pos: BlockCoord;
  progress: ubyte;
}

/// Moves up to `count` items between authoritative inventory slots. Client ->
/// server, and intent only: the server decides whether any move is legal and
/// sends a complete `InventoryState` when its answer changes the inventory.
/// There is no acknowledgement or rejection payload.
///
/// Decoder invariants the server enforces on this untrusted input:
///   - `from` and `to` must each be < `ServerWelcome.inventory_slots`
///   - `count == 0` is a protocol error; moving nothing is not an intent
table InventoryMoveRequest {
  from: ubyte;
  to: ubyte;
  count: ushort;
}

/// One swing of the held weapon. Client -> server, and intent only: the server owns
/// reach, cone, cooldown, target selection, damage and every consequence of a hit.
///
/// **It names no victim.** There is no target id, no position, no aim vector, no
/// damage and no result, because a message that let a client choose who it hit would
/// be a cheat vector however carefully the server re-checked the choice. The server
/// picks a target from the positions it already owns and from the latest aim it
/// accepted on this session's tick-paced `PlayerInput` — which is also why aim is not
/// repeated here. The movement frame carrying that tick is ordered ahead of the swing,
/// and two claims to the same aim would be two claims to reconcile.
///
/// There is no acknowledgement payload and no damage-result payload. A launcher missing
/// ammunition receives `ActionRefused{Attack, NoAmmunition}`; other refused attacks remain
/// silence. An accepted one becomes visible only through the authoritative `EntitySnapshot`,
/// `PlayerVitals`, projectile state and `InventoryState` that follow.
///
/// Decoder invariants the server enforces on this untrusted input:
///   - `slot` is copied verbatim, out-of-range values included. Whether an
///     authoritative slot holds a usable weapon is a decision, and decisions belong
///     to the simulation: it refuses a bad slot silently rather than closing a
///     connection whose framing is still perfectly readable.
///   - `client_tick` is ordering and staleness only, never a trusted clock
table AttackRequest {
  /// The authoritative inventory slot this swing spends. The server reads what is
  /// actually in that slot; naming an empty, resource or broken one gains nothing.
  slot: ubyte;

  /// The client's own tick counter, for ordering and staleness only.
  client_tick: uint;
}

/// Raising or lowering whatever the player currently holds in the off-hand.
/// Client -> server, and intent only: the server decides whether the authoritative
/// off-hand item can block, whether it has durability left and whether anything is
/// actually raised. The request carries no item, slot, damage reduction or outcome.
table BlockRequest {
  active: bool;

  /// The client's own tick counter, for ordering and staleness only.
  client_tick: uint;
}

/// Which recipe a `CraftRequest` names.
///
/// The wire carries the recipe's *identity*; what it costs and what it produces is the
/// server's table and is deliberately never sent, exactly as the item registry is not.
/// A client mirrors a display-only copy so it can gray out a row it cannot afford, and a
/// drift between the two copies can show a wrong label but can never create an item.
///
/// Zero member for the fail-closed reason `LifeState.Unknown` has one, and it matters
/// more here than there: this enum rides on a client→server message, so the zero value
/// is the one an omitted field produces and the one that has to be refused.
///
/// Members are **appended, never inserted**. The number is what the wire carries, so
/// renumbering compiles perfectly on both sides and silently turns one recipe into
/// another in every build already shipped — the same trap `Payload`'s union tags carry,
/// with nothing but this sentence to catch it.
enum RecipeID : ubyte {
  Unknown = 0,
  Forge = 1,
  IronSword = 2,
  SharpeningStone = 3,
  Tent = 4,
  Campfire = 5,
  LeatherPatch = 6,

  // The three implements, appended in V8. Appended and never inserted, for the reason
  // every member above was: the value is a byte on the wire, and a renumbering turns
  // every craft a client asks for into a different one.
  Shovel = 7,
  Pickaxe = 8,
  Axe = 9,

  // Raw meat cooked at a campfire, appended in V16. This travels client -> server in a
  // CraftRequest, so an older server must be rejected at the handshake rather than on
  // the first attempt to cook.
  CookedMeat = 10,

  // Six wearable pieces, appended in V19. These travel client -> server in a
  // CraftRequest, so an older server must be rejected at the handshake rather than
  // on the first attempt to make armour.
  LeatherCap = 11,
  LeatherJerkin = 12,
  LeatherLeggings = 13,
  IronHelm = 14,
  IronCuirass = 15,
  IronGreaves = 16,

  // V22 already reserves shield intent/state; this append ships on both V22 peers before
  // release, so there is no released same-version peer and no second bump is needed.
  WoodenShield = 17,

  // Bow and arrows follow the wooden shield without moving its assigned wire value.
  Bow = 18,
  Arrows = 19,
  WoodenSceptre = 20
}

/// A player trying to craft one recipe. Client -> server, and intent only.
///
/// It names no materials and no product: what a recipe consumes, what it yields, and
/// whether the player is standing near the station it needs are all the server's, read
/// from the authoritative inventory and the authoritative world. A message that let the
/// client state its own ingredients would be a cheat vector however carefully the server
/// re-checked them.
///
/// There is no acknowledgement and no rejection payload. A refused craft is silence; an
/// accepted one becomes visible only through the complete `InventoryState` that follows.
///
/// Decoder invariants the server enforces on this untrusted input:
///   - `recipe` must be a known non-zero member; `Unknown` is the absent-field case and
///     an unrecognised value is a client the server does not speak the recipes of. Both
///     are refused silently rather than closing a connection whose framing is fine
///   - `client_tick` is ordering and staleness only, never a trusted clock
table CraftRequest {
  recipe: RecipeID;

  /// The client's own tick counter, for ordering and staleness only.
  client_tick: uint;
}

/// A player trying to mend one carried item with one repair kit. Client -> server, and
/// intent only.
///
/// Two slot indexes and nothing else: which item is a legal kit, which target can be
/// worn at all, how much durability is restored and whether the target had room for it
/// are the server's, read from the slots it already owns. There is no durability value
/// on this message in either direction — a client that could state one could repair by
/// asking.
///
/// There is no acknowledgement and no rejection payload. A refused repair is silence; an
/// accepted one becomes visible only through the complete `InventoryState` that follows,
/// whose slot-indexed durability vectors carry the new value.
///
/// Decoder invariants the server enforces on this untrusted input:
///   - both indexes are copied verbatim, out-of-range values included, and refused by
///     the simulation rather than by the framing — whether a slot holds a usable kit is
///     a decision, and decisions belong to the server
///   - `kit_slot == target_slot` is refused the same way: nothing mends itself
///   - `client_tick` is ordering and staleness only, never a trusted clock
table RepairRequest {
  /// The authoritative inventory slot holding the repair kit this mend spends.
  kit_slot: ubyte;

  /// The authoritative inventory slot holding the item to mend.
  target_slot: ubyte;

  /// The client's own tick counter, for ordering and staleness only.
  client_tick: uint;
}

/// A player trying to consume one carried item. Client -> server, and intent only.
///
/// The slot names the authoritative stack to inspect. Whether its item is edible, how
/// much hunger it restores, whether the player is alive and whether the reserve has room
/// are all server decisions. A refusal is silence; success consumes exactly one item and
/// is visible through the complete `InventoryState` and subsequent `PlayerVitals`.
///
/// Decoder invariants the server enforces on this untrusted input:
///   - `slot` is copied verbatim, including values outside the announced inventory;
///     gameplay refuses an unusable slot without treating valid framing as a protocol error
///   - `client_tick` is ordering and staleness only, never a trusted clock
table ConsumeRequest {
  slot: ushort;
  client_tick: uint;
}

/// Which way a placed structure faces.
///
/// Four compass members rather than a yaw in radians: a structure's footprint is a set
/// of voxel cells, and a continuous angle would only ever be quantized to one of these
/// before the cells could be computed. Quantizing on the client and validating the
/// result is cheaper than quantizing on both sides and reconciling the difference.
///
/// Zero member for the same fail-closed reason as `RecipeID.Unknown`: it rides on a
/// client→server message, and an omitted facing must be refused rather than read as
/// north.
enum Facing : ubyte {
  Unknown = 0,
  North = 1,
  East = 2,
  South = 3,
  West = 4
}

/// A player trying to plant a structure in the world. Client -> server, and intent only.
///
/// The world's counterpart to `BlockEditRequest` for things that are entities rather
/// than voxels. Reach, whether the named slot actually holds that structure, whether the
/// footprint the facing implies is clear and supported, and whether the player is
/// already allowed another one are all resolved server-side and none of it is stated
/// here.
///
/// **It carries no structure id and no kind.** The kind follows from the item in `slot`,
/// which the server reads from its own inventory, and the id is minted by the server
/// when the structure comes into existence. A client that could name either could name
/// one it does not own.
///
/// There is no acknowledgement and no rejection payload, and no local placement is
/// entitled to appear: the structure exists when a snapshot says it does.
///
/// Decoder invariants the server enforces on this untrusted input:
///   - `anchor` is a struct field, so an absent one decodes as null (Go) / `None`
///     (Rust). Reject that; the origin is a real location, not a default
///   - `facing` must be a known non-zero member
///   - `slot` must be < `ServerWelcome.inventory_slots`
///   - `anchor` is unbounded on the wire and bounded by the server, under the same reach
///     rule a block edit obeys
///   - `client_tick` is ordering and staleness only, never a trusted clock
table PlaceStructureRequest {
  /// The authoritative inventory slot to spend on this placement.
  slot: ubyte;

  /// The voxel the structure is anchored at, in world coordinates. Which cells the
  /// footprint then occupies is the server's arithmetic, exactly as turning a
  /// `BlockEditRequest.pos` into a chunk and an index inside it is.
  anchor: BlockCoord;

  /// Which way the structure faces. The client quantizes its camera yaw to one of the
  /// four members; the server validates the result like it validates the anchor.
  facing: Facing;

  /// The client's own tick counter, for ordering and staleness only.
  client_tick: uint;
}

/// A player trying to take a placed structure back. Client -> server, and intent only.
///
/// It names an id the server minted and sent, which is the one kind of identifier a
/// client may echo back: ownership, reach and whether the structure still stands are
/// re-read from the authoritative registry, so naming someone else's — or one that
/// collapsed a tick ago — gains nothing.
///
/// There is no acknowledgement and no rejection payload. A refused removal is silence;
/// an accepted one becomes visible only through the snapshot that stops carrying the
/// structure and the drop that appears where it stood.
///
/// Decoder invariants the server enforces on this untrusted input:
///   - `structure_id` is copied verbatim, zero and unknown ids included, and refused by
///     the simulation: whether an id names a standing structure this player may remove
///     is a decision, not a framing question
///   - `client_tick` is ordering and staleness only, never a trusted clock
table RemoveStructureRequest {
  structure_id: ulong;

  /// The client's own tick counter, for ordering and staleness only.
  client_tick: uint;
}

/// A player putting one whole stack back on the ground. Client -> server, and intent
/// only.
///
/// **One slot index and nothing else.** What that slot holds, how much of it there is,
/// whether the player is alive to let go of anything and where "at their feet" is are all
/// read from state the server already owns — the shape `AttackRequest` and `RepairRequest`
/// already have. There is deliberately no count and no position: a count would let a client
/// state what leaves its own pack, and a position would let it put an item down anywhere in
/// the world.
///
/// **A whole stack, because the message cannot say otherwise.** Dropping part of one is a
/// field appended to this table later, like every other growth in this contract.
///
/// There is no acknowledgement and no rejection payload. A refused drop is silence; an
/// accepted one becomes visible as the complete `InventoryState` that follows and as the
/// `ItemDropState` that appears in the next `EntitySnapshot`.
///
/// Decoder invariants the server enforces on this untrusted input:
///   - `slot` is copied verbatim, out-of-range values included, exactly as
///     `AttackRequest.slot` is. Whether a slot holds something a player may put down is a
///     decision, and decisions belong to the simulation: it refuses a bad slot silently
///     rather than closing a connection whose framing is still perfectly readable
///   - `client_tick` is ordering and staleness only, never a trusted clock
table DropItemRequest {
  /// The authoritative inventory slot to empty onto the ground.
  slot: ubyte;

  /// The client's own tick counter, for ordering and staleness only.
  client_tick: uint;
}

/// A player asking to leave the world. Client -> server, and intent only.
///
/// Empty deliberately. The server owns the ten-second linger, so the client cannot
/// name a duration, an end time, or a cancellation. Once accepted, every later input
/// from this session is inert and the character remains in the simulation until the
/// server's countdown expires. Closing the socket instead reaches the same server-side
/// transition without this message, which is the feature's security boundary.
table LeaveRequest {
}

/// The server acknowledging that this session's irrevocable leave has begun.
/// Server -> client.
///
/// `remaining_ms` is the server-owned window at the moment this frame is produced. The
/// client may count it down for presentation, but it never removes the character or
/// decides that the leave completed; the connection ending is the authoritative result.
///
/// Decoder invariant: `remaining_ms` is non-zero. Zero would announce a countdown that
/// has already ended while the session still exists.
table LeaveStarted {
  remaining_ms: uint;
}

/// One line a player asks the server to send to the world chat. Client -> server,
/// and intent only.
///
/// The contract carries display text and states no acceptance rule. Length, cadence,
/// and whether the line may be delivered are server decisions; putting any of them
/// here would let a framing rule close a connection where the authoritative chat rule
/// should answer. The server may later refuse this request with `ActionRefused.Chat`.
///
/// Decoder invariant: `text` is copied verbatim, the empty string and any length
/// included. It is shown, never parsed, and never used as an identity.
table ChatRequest {
  text: string;
}

/// One world-chat line the authoritative server accepted. Server -> client.
///
/// Both strings are display text: they are shown and never parsed. The entity id is
/// the session handle that lets a consumer associate the line with a visible player;
/// the name is carried as text because an appearance description and a chat line are
/// separate streams and may arrive in either order.
///
/// Decoder invariants:
///   - `sender_entity_id` is non-zero
///   - `sender_name` is present; the empty string remains legal display text
///   - `text` is copied verbatim, absent and empty included
table ChatMessage {
  sender_entity_id: ulong;
  sender_name: string;
  text: string;
}

/// Which party operation a `PartyRequest` asks the authoritative server to perform.
///
/// Append-only. Zero exists so an absent field fails closed at the receiver instead of
/// becoming a real operation.
enum PartyAction : ubyte {
  Unknown = 0,
  Invite = 1,
  Accept = 2,
  Decline = 3,
  Leave = 4,
  Kick = 5
}

/// One request to change party membership. Client -> server, and intent only.
///
/// `target_name` is read only for `Invite` and `Kick`, copied verbatim, and never an
/// identity: the server resolves it against its own live name index. It is ignored for
/// `Accept`, `Decline`, and `Leave`; an empty value is therefore an ordinary encoding.
/// Every membership outcome remains the server's decision.
///
/// Decoder invariants:
///   - `action` is a known non-zero `PartyAction`; `Unknown` and unrecognised members
///     fail closed
///   - `target_name` is copied verbatim, the empty string and any length included
table PartyRequest {
  action: PartyAction;
  target_name: string;
}

/// A pending party invitation the authoritative server delivers. Server -> client.
///
/// `expires_ms` is a remaining count at the moment the frame is produced, never a
/// deadline. A client may count it down for presentation, but expiration and whether an
/// acceptance still succeeds remain server decisions — the same division
/// `LeaveStarted.remaining_ms` records.
///
/// Decoder invariants:
///   - `from_entity_id` is non-zero
///   - `from_name` is present; the empty string remains legal display text
///   - `expires_ms` is non-zero
table PartyInvite {
  from_entity_id: ulong;
  from_name: string;
  expires_ms: uint;
}

/// Ask to open the authoritative loot container attached to one corpse. Client -> server.
///
/// This is intent only. It names neither contents, ownership, eligibility nor the player's
/// position; the server resolves every one of those from its own state. `client_tick` is
/// ordering and staleness only and is never read as a clock.
///
/// Decoder invariant: `corpse_id` is non-zero and names the `entity_id` of the
/// `MobState` whose action is `Corpse`.
table LootOpenRequest {
  corpse_id: ulong;
  client_tick: uint;
}

/// Ask to move one stable entry from a corpse container into the player's inventory.
/// Client -> server.
///
/// The entry id is meaningful only inside the named corpse. The request deliberately
/// carries no item id, count, durability, ownership, position or inventory result; the
/// server resolves those from the container revision it owns. A stale revision is refused
/// rather than applied to a different complete state.
///
/// Decoder invariants:
///   - `corpse_id` is non-zero and names the `entity_id` of the `MobState` in `Corpse`
///   - `entry_id` is non-zero
///   - `revision` is non-zero
table LootTakeRequest {
  corpse_id: ulong;
  entry_id: ulong;
  revision: uint;
  client_tick: uint;
}

/// Ask to take every entry a corpse container holds, in entry order, for as long as the
/// player's pack has room. Client -> server.
///
/// It names no entry, no count and no order of its own: the server owns the entry order
/// and decides what fits, exactly as it does for `LootTakeRequest`. What it does carry is
/// the `revision` the client is looking at, for the same reason the single take does — a
/// request written against a window the server has since changed is refused
/// `StaleRevision` rather than quietly emptying a different container.
///
/// The answer is the ordinary loot vocabulary and nothing new. Emptied, the server sends
/// `LootClosed`; otherwise it sends a `LootState` of what remains, plus
/// `ActionRefused{TakeLoot, InventoryFull}` naming the first entry that did not fit.
/// **Partial success is success**: a request that moved anything advances the revision
/// exactly once, and the refusal reports the stopping point rather than undoing the rest.
/// A request that moved nothing at all is the refusal alone.
///
/// Decoder invariants:
///   - `corpse_id` is non-zero and names the `entity_id` of the `MobState` in `Corpse`
///   - `revision` is non-zero
table LootTakeAllRequest {
  corpse_id: ulong;
  revision: uint;
  client_tick: uint;
}

/// One authoritative stack in a corpse container.
///
/// A fixed struct because the complete list is replaced as one value and every entry has
/// the same settled shape. `entry_id` is stable for the lifetime of its corpse and is what
/// a later `LootTakeRequest` names; item id is never used as identity.
///
/// Decoder invariants:
///   - `entry_id`, `item_id` and `count` are non-zero
///   - no `entry_id` appears twice in one `LootState`
///   - `(durability, max_durability) == (0, 0)` means the stack does not wear out
///   - otherwise `max_durability` is non-zero, `durability <= max_durability`, and
///     `count == 1`; zero durability under a non-zero maximum is a legal worn-out item
struct LootEntry {
  entry_id: ulong;
  item_id: ushort;
  count: ushort;
  durability: ushort;
  max_durability: ushort;
}

/// The complete loot container state visible to one recipient. Server -> client.
///
/// A later state for the same corpse supersedes the earlier revision wholesale. The list
/// is per-recipient: two boss participants may receive different entries for the same corpse
/// without either learning the other's roll. Empty containers are ended with `LootClosed`
/// rather than represented by an empty state.
///
/// Decoder invariants:
///   - `corpse_id` is the non-zero `entity_id` of the `MobState` in `Corpse`
///   - `revision` is non-zero
///   - `entries` is present and non-empty
///   - every entry satisfies `LootEntry` and entry ids are unique
table LootState {
  corpse_id: ulong;
  revision: uint;
  entries: [LootEntry];
}

/// Explicitly ends an open loot container. Server -> client.
///
/// Sent when the corpse is empty, expired, reset or otherwise no longer available. The
/// client closes presentation and infers no reason from the message.
///
/// Decoder invariant: `corpse_id` is the non-zero entity id formerly carried by the
/// `MobState` whose container this message ends.
table LootClosed {
  corpse_id: ulong;
}

// -----------------------------------------------------------------------------
// The character's marks on the map.
//
// Sixty-four per character, stored server-side and never held anywhere else. The
// client draws what the server last said it holds; it does not keep a list of its
// own and reconcile, because a mark is small enough that the complete list is
// cheaper than any diff would be.
// -----------------------------------------------------------------------------

/// What a mark on the map means. A vocabulary, not a description.
///
/// The same shape `HairModel` is: the server stores the member and draws nothing, the
/// client maps it to an icon. That is why every one of these is a category and none of
/// them is a colour or a sprite name — a member is something both sides can carry without
/// agreeing on any asset.
///
/// `Note` is the member with no subject: a mark that is only its text. It is last rather
/// than first because it is the fallback, and a client that offers it as the default would
/// get a map of unlabelled pins.
///
/// Zero member for the reason every enum in this contract has one, and it fails closed in
/// both directions: a `MarkerPlaceRequest` that omits `kind` is refused rather than
/// guessed at, and a `Marker` that arrives carrying it is a protocol error rather than a
/// pin nobody can read.
enum MarkerKind : ubyte {
  /// Never sent deliberately, in either direction. The absent-field zero.
  Unknown = 0,

  Resource = 1,
  Cave = 2,
  Monster = 3,
  Boss = 4,
  Camp = 5,
  Village = 6,

  /// A mark that is only its note.
  Note = 7
}

/// A client asking to put one mark on its map. **Intent, never outcome.**
///
/// It carries no marker id, because identity is the server's to mint: a client that
/// named its own ids could collide with itself across two sessions, and a server that
/// accepted them would be taking an identifier from untrusted input. The answer is the
/// complete `MarkerList` that follows, exactly as a drop is answered by the complete
/// `InventoryState`.
///
/// Invariants the server enforces on this untrusted input:
///   - `kind` is a known member and is never `Unknown`
///   - `note` is at most 120 bytes and is valid UTF-8. Bytes rather than characters,
///     because a byte is what the wire and both decoders actually count; absent and
///     empty are the same empty note, and a mark with no note is ordinary
///   - `x` and `z` are block coordinates inside the world the server owns. The wire does
///     not bound them — `int` is the same width `BlockCoord` uses, for the same reason —
///     and the server refuses a mark outside its own extent
///   - the character holds fewer than 64 marks already; the 64th is the last one accepted
///   - `client_tick` is ordering and staleness only
///
/// Refused with `RefusedAction.PlaceMarker` and one of `TooManyMarkers`, `NoteTooLong`
/// or `MalformedKind`; a decoder that can see the violation from the frame alone may
/// close the session on it instead, which is the stricter of the two answers and the one
/// the Go server gives for `kind` and for `note`. Both are refusals, and neither puts a
/// mark on the map.
table MarkerPlaceRequest {
  /// Block x of the mark. No y: a mark is a place on a map, and a map has two axes.
  x: int;

  /// Block z of the mark.
  z: int;

  /// What the mark means. Never `Unknown` on the wire.
  kind: MarkerKind;

  /// The player's own text, copied verbatim. At most 120 bytes of valid UTF-8.
  note: string;

  /// The client's own tick counter. Ordering and staleness only.
  client_tick: uint;
}

/// A client asking to take one of its own marks off the map. **Intent, never outcome.**
///
/// There is no edit message, and its absence is the design: a mark is a kind, a place and
/// a line of text, and changing any of them is cheaper as a removal and a placement than
/// as a fourth message both sides have to keep exhaustive. The answer to either is the
/// same complete `MarkerList`.
///
/// Invariants the server enforces:
///   - `marker_id` is non-zero and names a mark this character owns. A mark belonging to
///     somebody else and a mark that never existed are one answer, `MarkerUnknown`
///   - `client_tick` is ordering and staleness only
table MarkerRemoveRequest {
  marker_id: ulong;
  client_tick: uint;
}

/// One mark on one character's map. Server -> client, and authoritative.
///
/// A table rather than a struct even though today's fields would inline: it is the least
/// settled shape the map adds — a colour, an icon override and a created-at time are all
/// things a later issue wants — and it carries a string, which a struct cannot hold at
/// all. That is the `Appearance` argument, and the string half of it settles the question
/// on its own.
///
/// Decoder invariants:
///   - `marker_id` is non-zero, and no id appears twice in one `MarkerList`
///   - `kind` is a known member and is never `Unknown`
///   - `note` is at most 120 bytes of valid UTF-8; absent and empty are the same
table Marker {
  /// Server-minted, stable for the life of the mark, and unique within the character.
  marker_id: ulong;

  x: int;
  z: int;
  kind: MarkerKind;

  /// The player's own text, exactly as the server stored it.
  note: string;
}

/// Every mark this character holds. Server -> client, and it **replaces** the client's
/// copy wholesale.
///
/// A complete list rather than a delta, for the reason `InventoryState` is one: sixty-four
/// marks are small, a delta needs a revision and an ordering to be applied safely, and a
/// client that has missed one delta is holding a map that is quietly wrong. Replacing is
/// the only operation with no history to get right.
///
/// An empty list is meaningful and ordinary — a character who has marked nothing, or has
/// just removed their last mark — which is why this message is not the one whose empty
/// case is refused. `MapExplored` is, and the difference is that it is additive: an empty
/// page of a ledger states nothing, where an empty list of marks states everything.
///
/// Decoder invariants:
///   - `markers` is present; empty is legal
///   - at most 64 entries
///   - every entry satisfies `Marker`, and marker ids are unique within the list
table MarkerList {
  markers: [Marker];
}

/// Which action a server refused, in an `ActionRefused`.
///
/// **Declared for every action that refuses in silence, not only the one that is
/// answered today.** Placement is the only member a server currently sends; mining,
/// block edits, crafting, repair and dropping all answer a refused request with a debug
/// line no player will ever read, and each becomes real in its own issue. Reserving the
/// members now is the call `StructureKind.Campfire` records: a member is an integer on
/// the wire, so the cheap moment to agree on the number is before anything depends on it.
///
/// **`RemoveStructure` is deliberately absent, and its absence is a decision rather than
/// an omission.** `RemoveStructureRequest` above says a refused removal is silence on
/// purpose: a client that could tell "no such structure" from "not yours" from "too far
/// away" could map somebody else's camp by asking for ids it does not have. A member
/// here would be an invitation to close that gap on some later afternoon without seeing
/// what it opens.
///
/// **`DropItem` is present for exactly the reason a removal is not.** Every question a
/// refused drop could answer is about the asking player's own pack — is that slot empty,
/// does that item wear out, are you dead — and they already hold the complete
/// `InventoryState` that says so. There is no third party's world state to learn by asking.
///
/// Zero member for the reason every enum in this contract has one: FlatBuffers decodes
/// an absent scalar as zero, so a refusal that names no action must read as one nobody
/// can act on rather than as a placement.
enum RefusedAction : ubyte {
  Unknown = 0,
  PlaceStructure = 1,
  MineBlock = 2,
  EditBlock = 3,
  Craft = 4,
  Repair = 5,
  DropItem = 6,
  Chat = 7,
  Party = 8,
  OpenLoot = 9,
  TakeLoot = 10,
  Attack = 11,

  // -- V24. The map's three client requests, appended for the reason the members above
  //    were reserved: the number is free now and will not be once anything depends on it.

  /// A `MapTileRequest` the server will not answer with a tile.
  RequestMapTile = 12,

  /// A `MarkerPlaceRequest` that put no mark on the map.
  PlaceMarker = 13,

  /// A `MarkerRemoveRequest` that took no mark off it.
  RemoveMarker = 14
}

/// Why a server refused an action, in an `ActionRefused`.
///
/// **Not `RejectReason`.** That enum lives in `handshake.fbs` and answers a different
/// question — why a *connection* was refused — and it is spelled in codes because it is
/// logged verbatim and shown to the player as-is. These members are domain tokens like
/// `Facing` and `StructureKind`: the receiving client turns each into a sentence, so
/// nothing here is ever displayed as written.
///
/// **Two groups, split by value, and the split is part of the contract:**
///
///   - **`1 .. 63` — the world, or the player's own state, refused a request that was
///     perfectly well formed.** There is nothing wrong with the peer that sent it: it
///     asked a legal question and the answer was no. This is the half a player is told
///     about, because it is the half they can do something about — step closer, find
///     flatter ground, take the old tent down.
///   - **`64 ..` — the request could not be honoured because of what it said.** An
///     absent anchor, a facing no client may send, a slot outside the announced
///     inventory. A correct client never produces one, so a receiver treats these as a
///     defect in the build that sent it rather than as news for the player.
///
/// Keeping the two apart on the wire is what lets a client say "the ground here is air"
/// to a player and "this build sent something the server could not read" to a log,
/// without a table of exceptions on either side. Append inside the group a reason
/// belongs to; a member is an integer on the wire and renumbering one relabels every
/// refusal already sent.
///
/// Zero member for the usual reason, and it carries more weight here than most: an
/// `ActionRefused` whose reason failed to decode must not read as a real refusal a
/// client would then explain to somebody.
enum RefusalReason : ubyte {
  Unknown = 0,

  // -- The world said no. A legal request, refused on its merits.

  /// A cell the footprint needs is in terrain the server has not composed yet. Reads on
  /// this path never generate, so the edge of loaded terrain is a refusal rather than a
  /// wait.
  GroundNotGenerated = 1,

  /// A cell the footprint rests on is air. A structure needs something to stand on.
  GroundIsAir = 2,

  /// A cell the structure needs clear above its footprint is in terrain the server has
  /// not composed yet. Distinct from `GroundNotGenerated` because the two answer
  /// different questions about different cells — is the ground there, is the space
  /// clear — and a validator that collapsed them would report the wrong cell.
  SpaceNotGenerated = 3,

  /// A block occupies space the structure needs.
  SpaceBlocked = 4,

  /// The target is further from the player than the server's reach allows, measured
  /// against the position the *server* computed.
  OutOfReach = 5,

  /// The player is dead. The dead act on nothing.
  PlayerIsDead = 6,

  /// The named inventory slot holds nothing.
  SlotEmpty = 7,

  /// What the named slot holds is not something that can be used this way — an item
  /// that plants no structure, for a placement. Not a malformed request: an inventory
  /// that changed between the click and its arrival produces this honestly.
  SlotUnusable = 8,

  /// The named slot no longer holds the item the action was about, at the moment the
  /// server came to spend it.
  SlotChanged = 9,

  /// The player's inventory was busy and the action was refused rather than made to
  /// wait. Rare by construction and answered rather than hidden.
  InventoryBusy = 10,

  /// This player already has a tent standing. One tent to a player, because a tent is
  /// where they come back to and two answers to that is a choice nobody made.
  TentAlreadyPlaced = 11,

  /// Chat was sent faster than the server's authoritative rate allows.
  TooFast = 12,

  /// The party already holds the maximum number of members.
  PartyFull = 13,

  /// No online player matches the target display name.
  NoSuchPlayer = 14,

  /// The player the request concerns already belongs to a party.
  AlreadyInParty = 15,

  /// There is no live invitation for this player to accept or decline.
  NoInvite = 16,

  /// This party operation is reserved for the current leader.
  NotLeader = 17,

  /// The named corpse has expired, reset, been emptied or never existed for this player.
  CorpseUnavailable = 18,

  /// The player is not the solo tap owner or the normal-party round-robin owner.
  LootNotOwned = 19,

  /// The request names a loot revision older or newer than the complete state now held.
  StaleRevision = 20,

  /// The inventory has no slot able to receive the authoritative loot entry.
  InventoryFull = 21,

  /// The selected launcher is usable, but no matching ammunition exists in the
  /// player's authoritative hotbar or pack.
  NoAmmunition = 22,

  /// The tile request named an origin that is not a multiple of `64 * scale`, or a scale
  /// outside `{1, 4, 16}`.
  ///
  /// **In the low group deliberately, and the split's own words are why.** The line is
  /// "it asked a legal question and the answer was no", and the party this answer is news
  /// for is the client rather than the player: the map is the one surface where the
  /// *client* chooses the numbers, and its recourse is to ask again on the grid. The
  /// 64-and-above group is for a request the server could not read at all, which this one
  /// is not — every field is present and every value is in range for its type.
  TileMisaligned = 23,

  /// This character already holds the maximum number of marks. One map to a character and
  /// sixty-four marks on it, because a map nobody can read is not a map.
  TooManyMarkers = 24,

  /// The note is longer than the 120 bytes a mark may carry. In the low group for the same
  /// reason `TileMisaligned` is, and more plainly: the player typed too much, and the
  /// remedy is theirs.
  NoteTooLong = 25,

  /// The named mark does not belong to this character, or no longer exists. One answer for
  /// both, deliberately: telling them apart would let a client learn that somebody else's
  /// mark exists by naming ids it was never given — the argument `RefusedAction` records
  /// for having no member for a refused structure removal at all.
  MarkerUnknown = 26,

  // -- The request said something no correct client sends. A defect in the peer.

  /// The request carried no anchor at all. The origin is a real place, so an absent
  /// struct field is refused rather than read as (0, 0, 0).
  MalformedNoAnchor = 64,

  /// The request named a facing no client may send: the absent-field zero, or a value
  /// this contract has no member for.
  MalformedFacing = 65,

  /// The request named an inventory slot outside the count `ServerWelcome` announced.
  MalformedSlot = 66,

  /// The request resolved to something the server has no footprint, recipe or table
  /// entry for. Unreachable from a correct client and from a correct server both, and
  /// carried anyway: the alternative to a code is a refusal that looks like the world's.
  MalformedKind = 67
}

/// The server's answer to an action it refused. Server -> client.
///
/// **The first message in this contract that says no to anything but a connection.**
/// Every refused action before it was silence plus a line in a server log: the reason
/// was computed, written down where no player could reach it, and thrown away. A
/// placement that vanishes with no answer is indistinguishable from a lost packet, from
/// a click that missed, and from a bug — and the one thing it is not indistinguishable
/// from is a placement that worked, which is the only feedback the player had.
///
/// **It is not an acknowledgement, and there is still no acceptance payload.** A
/// structure exists when a snapshot says it does; nothing here changes that, and a
/// client must never treat the *absence* of an `ActionRefused` as a yes. This message
/// carries one thing: the reason a thing that did not happen did not happen.
///
/// **Appending it is not a protocol break.** Union members are append-only, this is
/// tag 20, and a peer built against an earlier contract reads an unknown tag as a
/// payload it has no name for and drops it. So an older client loses the feedback and
/// nothing else, which is why `ProtocolVersion.Current` does not move for this.
///
/// Decoder invariants:
///   - `action` and `reason` are both read through their zero members: an absent or
///     unrecognised value is `Unknown`, and a receiver shows a player nothing rather
///     than inventing a sentence for a code it cannot read. It never fails the frame —
///     a refusal is the least important message on the wire, and a decode error would
///     end a session over one
///   - `anchor` is absent whenever the refused request named no voxel, which includes
///     every request that carried no anchor at all. Present or absent, never zero as a
///     stand-in for absent
table ActionRefused {
  /// Which action was refused. Enough on its own to route the answer, because at most
  /// one of a player's actions is in flight per press.
  action: RefusedAction;

  /// Why. The whole point of the message.
  reason: RefusalReason;

  /// The voxel the refused request named, when it named one — the anchor of a
  /// placement, the target of a mine or a block edit. Absent for an action that names
  /// no cell, and absent for a request whose anchor was the thing that was missing.
  ///
  /// Carried so a client can show the answer where the player was looking rather than
  /// only in a line of text, and so a refusal that raced ahead of the player's aim is
  /// recognisable as belonging to somewhere else.
  anchor: BlockCoord;
}

/// One entity's authoritative state at a server tick.
///
/// A struct so that a snapshot's entity list is a flat, inlined array: this is
/// the most frequently sent payload in the game.
///
/// The finite-float invariant runs in this direction too: a non-finite `pos`
/// would poison the client's interpolation and, through the entity's transform,
/// its renderer. The server must never emit one, and the client validates rather
/// than assuming it never does.
///
/// **V7 added an appearance to every player and added nothing here.** What a
/// character looks like travels in `PlayerAppearance` at the bottom of this file;
/// the argument for keeping it out of this struct is written there, beside the
/// message that carries it instead. Four fields, unchanged since V1, and the
/// encoded size of this struct is pinned by a test on both sides — which is what
/// catches somebody quietly adding a fifth.
///
/// **V10 gave every player a death every viewer can see and added nothing here
/// either.** Whether a player is down rides beside this vector, in
/// `EntitySnapshot.dead_players`, where it costs nothing on the ticks nobody is
/// dead. A fifth field here would have charged every visible player those bytes on
/// every tick to say "no", and could never have been taken back.
struct EntityState {
  entity_id: ulong;
  pos: Vec3;
  vel: Vec3;
  yaw: float;
}

/// Which settled projectile presentation the authoritative server is streaming.
/// Zero is reserved for absent or unknown kinds, so a decoder refuses it.
enum ProjectileKind : ubyte {
  Unknown = 0,
  Arrow = 1,
  EnergyOrb = 2
}

/// One projectile in the authoritative world snapshot.
///
/// A struct because this is fixed-size hot state carried once per visible projectile
/// per tick. Its field list can therefore never lose, reorder or change a field.
///
/// Decoder invariants:
///   - every component of `pos` and `vel` is finite
///   - `kind` is a known non-zero member
///
/// A consumer may leave the append-only projectile vector unread. Once it reads these
/// values for presentation, it enforces both invariants before using any component.
struct ProjectileState {
  entity_id: ulong;
  pos: Vec3;
  vel: Vec3;
  kind: ProjectileKind;
}

/// One dropped item in the authoritative world snapshot.
///
/// A separate struct rather than a discriminant on `EntityState`: drops are not
/// players, and adding fields to the hottest struct in the game would charge
/// every player entity those bytes for ever. As with every FlatBuffers struct,
/// this field list can never lose, reorder or change a field.
///
/// Decoder invariants:
///   - every `pos` component is finite
///   - `item_id` is never 0, which is reserved for no item
///   - `count` is never 0; a drop with nothing in it is despawned, not sent
///   - an `entity_id` never names both a player and a drop in one snapshot
struct ItemDropState {
  entity_id: ulong;
  pos: Vec3;
  item_id: ushort;
  count: ushort;
}

/// The wear carried by one dropped item, beside `ItemDropState` rather than inside it.
///
/// Sparse by design: almost every drop is a block yield, loot roll or structure bundle
/// and therefore has no durability. Keeping this in a parallel vector leaves those
/// common drops at the 24-byte fixed layout they have always had; converting every drop
/// to a table would charge an offset and a vtable to every element in the hottest
/// per-entity snapshot array, including all the ones with no wear to say.
///
/// Invariants a decoder must enforce:
///   - `entity_id` names exactly one member of `EntitySnapshot.drops`
///   - no entity id appears twice in `EntitySnapshot.drop_durabilities`
///   - `max_durability` is non-zero and `durability` does not exceed it
///   - the matching drop has count 1; two durable objects cannot share one wear value
///
/// Absence means the matching drop does not wear out. The client may render this state,
/// but never supplies it: durability enters the world only from the server's authoritative
/// inventory and returns through that same server-side rule.
struct ItemDropDurability {
  entity_id: ulong;
  durability: ushort;
  max_durability: ushort;
}

/// Whether the server considers a player alive or dead.
///
/// A zero member for the reason `ProtocolVersion.Unknown` has one: FlatBuffers decodes
/// an absent scalar as its type's zero value, so a `PlayerVitals` carrying no life
/// state must fail closed rather than read as "alive".
enum LifeState : ubyte {
  Unknown = 0,
  Alive = 1,
  Dead = 2
}

/// What kind of creature a `MobState` describes.
///
/// Zero member for the same fail-closed reason as `LifeState`: an unknown kind is a
/// contract the receiver does not speak, and drawing a default enemy in its place
/// would put a creature in the world that the server never said was there.
///
/// Members are appended, never inserted, for the reason `RecipeID`'s are: a renumbering
/// would draw one creature where the server said another, and no compiler would object.
enum MobKind : ubyte {
  Unknown = 0,
  Draugr = 1,
  Vargr = 2,

  /// A passive animal that runs from nearby live players rather than attacking them.
  Deer = 3
}

/// What a mob is doing this tick, as the server's finite-state machine holds it.
///
/// Presentation reads this to telegraph an attack; it never advances it. The mob's
/// action changes when the server says so and at no other moment. Zero member for the
/// same fail-closed reason as `LifeState`.
enum MobAction : ubyte {
  Unknown = 0,

  /// Standing at its anchor with no target.
  Idle = 1,

  /// Moving toward the target the server chose.
  Chase = 2,

  /// Committed to an attack that has not landed yet. This is the telegraph.
  Windup = 3,

  /// Cannot attack again until this expires. The server's answer to attack cadence.
  Recovery = 4,

  /// Killed, and going down. The creature has no health left and is not coming back;
  /// the server holds the fall here for its presentation span and then advances the
  /// same entity to `Corpse`. Ordinary mob loot never becomes a ground drop.
  ///
  /// **It is the only statement of death this contract makes about a mob, and it is
  /// what a receiver must animate on.** There is no `LifeState` beside a `MobState` and
  /// there is no removal event: a creature that leaves a snapshot may have been killed,
  /// may have walked out of the streamed cube, or may have been taken away by the
  /// daylight, and those three are indistinguishable from the outside. Zero `health` is
  /// not the signal either — it is a *consequence* of this member, sent alongside it,
  /// and a receiver that read the number instead of this field would be inferring a
  /// gameplay fact the server is already stating.
  ///
  /// Nothing about the pose is here. How long a body takes to go down, and which way it
  /// falls, are presentation; when the server advances it to `Corpse` is not.
  Dying = 5,

  /// Moving directly away from the nearest live player the server chose as a threat.
  Flee = 6,

  /// Dead and available as a server-owned loot container. The body neither moves nor
  /// acts, and remains until its authoritative expiry rather than becoming a ground drop.
  /// Which recipients may open it is carried separately and per recipient.
  Corpse = 7
}

/// The recipient's own health and life state, as the server holds them.
///
/// Per-recipient, and carried inside `EntitySnapshot` so that health arrives on the
/// same superseding stream as every other authoritative fact. A dropped snapshot is
/// harmless: the next one carries the complete answer, so there is nothing to merge
/// and nothing to replay. There is no client -> server counterpart, for the same
/// reason there is no client-sent position: what a player's health *is* is a gameplay
/// outcome, and outcomes belong to the server.
///
/// Invariants a decoder must enforce, because a receiver divides by one of these and
/// branches on another:
///   - `max_health` is non-zero — a health bar drawn as `health / max_health` divides
///     by it, and an honestly buggy server reaches that division as easily as a
///     hostile one
///   - `health` never exceeds `max_health`
///   - `life_state` is a known non-zero member; `Unknown` is the absent-field case
///   - an `Alive` player has positive health
///   - only a `Dead` player may carry a non-zero `respawn_ticks`
///   - `life_state` agrees with `EntitySnapshot.dead_players`: the recipient's own entity
///     id is in that vector exactly when this says `Dead` — see that field, where the
///     reason one fact is stated twice is argued
///   - `blocking` agrees with `EntitySnapshot.blocking_players`: the recipient's own
///     entity id is in that vector exactly when this is true
table PlayerVitals {
  /// Current health, in the same units as `max_health`. Zero is legal and means the
  /// player is dead — the server's transition to `Dead` is what makes it so, not the
  /// number.
  health: ushort;

  /// Maximum health. Non-zero, always: it is the denominator of every health display.
  max_health: ushort;

  life_state: LifeState;

  /// Server ticks remaining before the server respawns this player, counted at
  /// `ServerWelcome.tick_rate`. Zero for a living player. **A count, never a
  /// deadline**: the client converts it for display and holds the value unchanged
  /// while snapshots are absent, exactly as it holds an entity's last position rather
  /// than extrapolating one.
  respawn_ticks: uint;

  /// Whether the server is currently refusing damage to this player. The server owns
  /// the timer; this is the answer, not a duration to run down locally.
  invulnerable: bool;

  /// Current hunger reserve, in the same units as `max_hunger`. Zero is legal: it
  /// prevents health regeneration but does not itself damage the player.
  hunger: ushort;

  /// Maximum hunger. Non-zero, always: it is the denominator of every hunger display.
  max_hunger: ushort;

  /// The recipient's current level. Never zero: the first level is level 1.
  level: ushort;

  /// Experience earned into the current level. Never exceeds `experience_to_next`.
  /// At the level cap the two values are equal.
  experience: uint;

  /// Experience required to complete the current level. Never zero: it is the
  /// denominator of every experience display.
  experience_to_next: uint;

  /// Whether the authoritative server currently holds this recipient's off-hand raised.
  /// Intent alone never makes this true; the server's equipment and durability rules do.
  blocking: bool;
}

/// One mob's authoritative state in a snapshot.
///
/// A **table**, deliberately, where players and drops are structs. A FlatBuffers
/// struct can never gain, lose or reorder a field, and that price is only worth paying
/// for a shape that has settled: `EntityState` is the player transform this game has
/// been sending since V1. The first mob representation is not that, so it stays
/// evolvable and pays an offset per mob for the privilege.
///
/// Mobs ride beside `EntitySnapshot.entities` rather than inside it for the reason
/// `ItemDropState` does: adding a kind and a health to the hottest struct in the game
/// would charge every player entity those bytes forever.
///
/// Invariants a decoder must enforce:
///   - `entity_id` is non-zero and globally unique — one id never names a mob and a
///     player, or a mob and a drop, or two mobs, in the same snapshot
///   - `pos` and `vel` are present; an absent struct field decodes as null, and the
///     origin is a real location rather than a default
///   - every float is finite, in this direction too: a `NaN` position would pass
///     through interpolation into a transform and never leave
///   - `kind` and `action` are known non-zero members
///   - `max_health` is non-zero and `health` never exceeds it
///
/// **Zero `health` is legal and always has been** — there is no "an alive mob has
/// positive health" invariant here, unlike `PlayerVitals` — and since `MobAction.Dying`
/// it is also reachable, because a body on its way down is sent with nothing left. It
/// still says nothing on its own: see `Dying`.
table MobState {
  entity_id: ulong;

  kind: MobKind;

  pos: Vec3;

  /// Carried for diagnostics, exactly as `EntityState.vel` is: the client
  /// interpolates between two positions rather than extrapolating from a velocity.
  vel: Vec3;

  /// Facing, in radians, wrapped by the server.
  yaw: float;

  health: ushort;

  max_health: ushort;

  action: MobAction;

  /// The player this mob is hunting on this tick, or zero when it has no target.
  /// Presentation only: the client may draw the relationship but never acts on it,
  /// computes threat or uses it to decide any gameplay outcome.
  target_entity_id: ulong;
}

/// One monster blow that reduced this recipient's authoritative health.
///
/// An event rather than snapshot state: the client uses it only to decide whether
/// the attacker was outside its active camera frustum at impact. It must never
/// infer one from a health delta or a mob action transition.
///
/// Invariants a decoder must enforce:
///   - `attacker_entity_id` is non-zero
///   - `attacker_pos` is present and every component is finite
table MobHit {
  attacker_entity_id: ulong;

  /// The authoritative monster position at the instant its blow landed.
  attacker_pos: Vec3;
}

/// What kind of thing a `StructureState` describes.
///
/// Zero member for the same fail-closed reason as `MobKind.Unknown`: an unrecognised
/// kind is a contract the receiver does not speak, and drawing a default building in its
/// place would put a shelter in the world the server never said was there.
///
/// Members are appended, never inserted, for the reason `RecipeID`'s are.
enum StructureKind : ubyte {
  Unknown = 0,
  Tent = 1,
  Forge = 2,
  Campfire = 3
}

/// One placed structure's authoritative state in a snapshot.
///
/// **Structures are entities, not voxels.** They ride beside `EntitySnapshot.entities`
/// rather than becoming blocks, so chunk data, the run-length palette and the edit layer
/// are all untouched by a camp going up: a tent is not nine blocks the world has to
/// remember, it is one thing the simulation owns.
///
/// A **table**, for exactly the reason `MobState` is one: a FlatBuffers struct can never
/// gain, lose or reorder a field, and that price is only worth paying for a shape that
/// has settled. The first structure representation is not that — health, damage state
/// and per-kind detail are all plausible next fields — so it stays evolvable and pays an
/// offset per structure for the privilege.
///
/// There is no position vector and no yaw here, unlike every other entity in this file.
/// A structure sits on the voxel grid and faces one of four ways, so an anchor cell plus
/// a `Facing` says everything about where it is; a float transform would invite an
/// interpolator to move something that never moves.
///
/// Invariants a decoder must enforce:
///   - `structure_id` is non-zero and globally unique — one id never names a structure
///     and a player, or a structure and a drop, or a structure and a mob, in the same
///     snapshot, and never two structures
///   - `owner_entity_id` is the owner's **current** entity id while the owner has a live
///     session, and `0` while the owner is offline. Zero is legal in this one field from
///     protocol V5 on, and nowhere else. "Every structure was placed by somebody" is still
///     true — but of a server-side identity that never crosses the wire, where an entity
///     id is only that identity's handle for one session. The structure outlives the id
///     that placed it, and gets an id again, not necessarily the same one, when its owner
///     reconnects
///   - `anchor` is present; an absent struct field decodes as null, and the origin is a
///     real location rather than a default
///   - `kind` and `facing` are known non-zero members
table StructureState {
  structure_id: ulong;

  kind: StructureKind;

  /// The voxel the structure is anchored at, in world coordinates — the same cell the
  /// placing `PlaceStructureRequest` named. The footprint the rest of it occupies
  /// follows from the kind and the facing, and both sides derive it the same way.
  anchor: BlockCoord;

  facing: Facing;

  /// The entity id the owner holds right now, or `0` while the owner has no live session.
  /// Carried so a session can tell its own camp from someone else's; it is not a
  /// permission the client enforces, since removal is refused by the server and not by
  /// the renderer.
  ///
  /// A session handle, not an identity. The server keys ownership by the identity behind
  /// `ClientHello.player_token`, which never appears on the wire; this field is that
  /// identity's current entity id, and `0` says it has none at the moment. So `0` does not
  /// mean unowned, a value that changes does not mean the structure changed hands, and a
  /// mapping from id to owner is good for this session only.
  owner_entity_id: ulong;
}

/// One other member of the recipient's party, carried in every snapshot while the
/// party exists.
///
/// A struct because this is fixed, hot data: health and position for a small bounded
/// group, inlined rather than reached through one table offset per member. It deliberately
/// carries no name or appearance; those already travel through `PlayerAppearance`.
///
/// Decoder invariants, together with the owning `EntitySnapshot`:
///   - `entity_id` is non-zero and appears only once in `party_members`
///   - `pos` is finite
///   - `max_health` is non-zero and `health <= max_health`
///   - the recipient's own entity id never appears
struct PartyMemberState {
  entity_id: ulong;
  pos: Vec3;
  health: ushort;
  max_health: ushort;
  alive: bool;
}

/// One character in the complete stable party roster.
///
/// A table rather than the fixed `PartyMemberState` combat struct because names and
/// connection state are not hot spatial data and this shape may grow. `character_id`
/// survives every session; `entity_id` is only the current online handle. The roster is
/// authoritative order, includes the recipient, and its first entry is the leader — so
/// an offline leader remains representable without inventing entity id zero as a body.
///
/// Decoder invariants, together with the owning `EntitySnapshot`:
///   - `character_id` is non-zero and unique
///   - `name` is present; the empty string remains legal display text
///   - `online` is true exactly when `entity_id` is non-zero
///   - non-zero `entity_id` values are unique
table PartyRosterMember {
  character_id: ulong;
  entity_id: ulong;
  name: string;
  online: bool;
}

/// The authoritative state of every entity a session can see, for one tick.
///
/// The client renders from these, interpolating between the two most recent. It
/// does not correct them, rewind them, or override them with a local
/// simulation.
table EntitySnapshot {
  /// The server tick this snapshot describes. Monotonic per session.
  server_tick: uint;

  entities: [EntityState];

  /// Dropped items visible to this session. Empty when there are none; kept
  /// separate from `entities` so the hot player struct remains unchanged.
  drops: [ItemDropState];

  /// Mobs visible to this session, under the same chunk-visibility rule the players
  /// and drops above obey. Empty when there are none, and the newest snapshot is the
  /// **complete** existence set: a mob the server stops sending has stopped existing
  /// for this session, and the client despawns it rather than inferring a reason.
  mobs: [MobState];

  /// This recipient's own health and life state.
  ///
  /// `(required)`, and it is the only required field in this contract. The rest of a
  /// snapshot describes what a session can *see*, which can legitimately be nothing;
  /// vitals describe the player the snapshot is addressed to, and there is no such
  /// thing as a session with no player.
  ///
  /// **The attribute is enforced on one side only, and it is worth knowing which.**
  /// flatc's Rust output visits the field with its required flag set, so the
  /// verifier `decode` runs refuses an absent one before any field of it is read.
  /// flatc's **Go** output emits no such assertion — `EntitySnapshotEnd` is a bare
  /// `EndObject` — so nothing stops a Go encoder from omitting it. What guarantees
  /// the server never does is that there is exactly one snapshot encoder and vitals
  /// are a plain field of the value it takes, so there is no call that can leave them
  /// out; `TestEntitySnapshotAlwaysCarriesTheRecipientsVitals` is what says so.
  self_vitals: PlayerVitals (required);

  /// Structures visible to this session, under the same chunk-visibility rule the
  /// entities, drops and mobs above obey. Empty when there are none, and the newest
  /// snapshot is the **complete** existence set exactly as `mobs` is: a structure that
  /// stops being sent has stopped existing for this session, and the client despawns it
  /// rather than inferring a reason. Removed by its owner, collapsed under a broken
  /// block, or simply out of view are the same fact on the wire, and none of the three
  /// is a thing the client is entitled to distinguish.
  structures: [StructureState];

  /// The tick of the world's day this snapshot describes, when the server keeps a clock:
  /// always less than `ServerWelcome.day_length_ticks`, and not read at all when that
  /// value is zero.
  ///
  /// **The one field here that is not about an entity**, and it rides along rather than
  /// arriving as a message of its own because it changes every tick and is read by the
  /// same frame the entities are drawn from. A separate message would arrive on its own
  /// schedule and put the sky a tick away from the world underneath it.
  ///
  /// A value at or beyond a declared `day_length_ticks` is a protocol error, never
  /// wrapped and never clamped. The two numbers come from the same server in the same
  /// session, so a disagreement between them is a bug reporting itself, and a receiver
  /// that quietly repaired it would be hiding the only evidence.
  tick_of_day: uint;

  /// The entity ids of the players in `entities` the server currently holds dead.
  ///
  /// **A fact about the world, not an event.** It rides in every snapshot rather than in a
  /// message announcing a death, so a session that joined afterwards, or whose view has
  /// only just reached the body, is told exactly what the session that watched it happen
  /// was told. It says who is down *now*, and the newest snapshot is the complete answer in
  /// the same way `mobs` and `structures` are.
  ///
  /// **Why a sparse list of ids rather than a life state beside every player.**
  /// `EntityState` is a struct — inlined once per visible player per tick, and its field
  /// list can never be taken back — so the state cannot go in it; that argument is written
  /// above the struct itself. Of the two shapes that leaves, a table per player in the shape
  /// `MobState` took would charge every *living* player a vtable and an offset every tick to
  /// carry the answer "no", which is the answer almost every entry has almost all the time.
  /// This vector is empty on almost every tick of almost every session, and FlatBuffers
  /// writes nothing at all for an empty one, so an ordinary snapshot pays nothing for it and
  /// a death costs eight bytes for as long as it lasts.
  ///
  /// **The price is two structures that could disagree, and the invariants below are the
  /// answer.** They are enforced at the decode boundary rather than trusted, because both
  /// halves arrive in one frame from one server: a disagreement is a bug reporting itself,
  /// and a receiver that quietly repaired it would be hiding the only evidence — the
  /// reasoning `tick_of_day` records one field above, with the difference that this one
  /// *can* be checked where it lands, since nothing it names arrived in another message.
  ///
  /// **`self_vitals` stays the recipient's own authority and is not made redundant.** What
  /// this adds is the one bit of that state which is a property of a body standing in the
  /// world, so the recipient's own body and everybody else's are drawn from one statement
  /// instead of two that can drift apart.
  ///
  /// Decoder invariants:
  ///   - every id names a player in this snapshot's `entities`. An id for a player the
  ///     recipient cannot see is a protocol error, not a body to remember for later
  ///   - no id appears twice
  ///   - the recipient's own entity id is present **exactly when** `self_vitals.life_state`
  ///     is `Dead`. The two are the same fact stated once each way, and a frame in which
  ///     they disagree is refused
  ///   - absent and empty are the same thing, and both are ordinary: nobody in view is dead
  ///
  /// Nothing about how a body goes down is here. How long a fall takes, which way it tips,
  /// and what a receiver draws for a player it first sees already dead are presentation —
  /// the same division `MobAction.Dying` states for a creature.
  dead_players: [ulong];

  /// Wear for the sparse subset of `drops` that came from durable inventory slots.
  /// Block yields, loot rolls and structure bundles carry no entry and remain wearless.
  /// See `ItemDropDurability` for the invariants tying the two vectors together.
  ///
  /// **V11 appends this field and changes no existing drop's fixed layout.** A V11
  /// receiver interprets absence as wearless, so a V10 server would silently turn a
  /// worn ground item pristine in presentation while the server later returned it worn.
  /// `ProtocolVersion.Current` therefore moves rather than allowing two peers to assign
  /// different state to the same drop after a clean handshake.
  drop_durabilities: [ItemDropDurability];

  /// The current party leader's live entity id, or `0` when there is no party **or the
  /// stable leader at `party_roster[0]` is offline**.
  ///
  /// A non-zero leader may be the recipient itself or one of `party_members`. The
  /// decoder that sees only this frame compares it with the roster's first entry: an
  /// online leader must carry that same non-zero entity id, and an offline leader must
  /// carry zero. When the roster is empty this field and `party_members` are both empty.
  /// A non-zero leader may be the recipient and therefore absent from `party_members`.
  party_leader_entity_id: ulong;

  /// Every **other** member of the recipient's party, in authoritative party order.
  /// Empty when the recipient is in no party.
  ///
  /// **Why this widens a snapshot beyond ordinary visibility.** `dead_players` is sparse
  /// state only for bodies already present in `entities`, and `PlayerVitals` exposes one
  /// player's health only to that player. Party membership is explicit consent to share
  /// position and health with the other members, including outside the streamed view, so
  /// this vector is the narrow exception rather than a field on `EntityState` paid by every
  /// visible player. For everyone outside a party it is absent and costs zero bytes.
  ///
  /// Decoder invariants:
  ///   - no `entity_id` appears twice
  ///   - every member has finite `pos`, non-zero `max_health`, and
  ///     `health <= max_health`
  ///   - the recipient's own entity id never appears; this must be checked by a layer that
  ///     also holds `ServerWelcome.entity_id`, not by a frame-only decoder
  ///   - every member maps to an online non-zero entity in `party_roster`
  ///   - when the roster is empty this vector is empty
  ///   - a non-zero leader is either the recipient or one of the members; the
  ///     recipient-aware consumer checks which when it has the welcome and snapshot together
  party_members: [PartyMemberState];

  /// The complete ordered party roster, including the recipient. Empty means no party;
  /// otherwise the first entry is the leader. Unlike `party_members`, this remains complete
  /// when a member disconnects and uses stable character identity for every position.
  ///
  /// `party_leader_entity_id` is the first entry's live entity id while the leader is
  /// online and zero while that leader is offline. Zero therefore no longer implies that
  /// `party_members` or this roster is empty; it never names an online entity.
  party_roster: [PartyRosterMember];

  /// Corpse ids that still hold loot this recipient may access. Each id is exactly the
  /// `entity_id` of one `mobs` entry whose action is `Corpse`; a receiver rejects an id
  /// that names no such body. Complete per snapshot:
  /// a later vector replaces the former one, absence and empty both mean none, and ids
  /// are non-zero and unique. It carries access, never contents; opening one asks the
  /// server for a per-recipient `LootState`.
  accessible_loot_corpses: [ulong];

  /// Projectiles visible to this session. Absence and empty both mean that no projectile
  /// is in view. An arrow resting in terrain remains a projectile with zero velocity until
  /// the authoritative server drops it from this complete per-snapshot set.
  projectiles: [ProjectileState];

  /// The entity ids of players in `entities` whose off-hand the server currently holds
  /// raised. Sparse like `dead_players`: absence and empty both mean nobody in view is
  /// blocking, and the newest snapshot is the complete answer.
  ///
  /// Decoder invariants:
  ///   - every id names a player in this snapshot's `entities`
  ///   - no id appears twice
  ///   - the recipient's own entity id is present exactly when `self_vitals.blocking`
  ///     is true; a frame where the two statements disagree is refused
  ///
  /// A consumer may leave both append-only blocking fields unread. Once it reads either
  /// for presentation, it validates this complete set and the cross-field agreement first.
  blocking_players: [ulong];
}

/// Everything the player is carrying, as the server holds it.
///
/// Sent whole whenever it changes: there is no delta form and no partial update,
/// so the client replaces its copy rather than merging into it. The client never
/// adds, removes, reorders or splits a stack on its own — what is in an
/// inventory is a gameplay outcome, and outcomes belong to the server. There is
/// no client→server counterpart to this message, for the same reason there is no
/// client-sent position.
///
/// **Encoding**: `stacks` is a slot-indexed flat vector of `(item_id, count)`
/// pairs — `stacks[2i]` is slot `i`'s item id and `stacks[2i+1]` is its count.
/// It contains exactly `ServerWelcome.inventory_slots` pairs (therefore exactly
/// twice that many `ushort` scalars). Flat rather than a vector of tables for the
/// reason `ChunkData.runs` is flat: a table per slot costs an offset each, and
/// this message is resent in full every time a single item moves.
///
/// Invariants a decoder must enforce:
///   - `stacks` has an even length
///   - its pair count is exactly `ServerWelcome.inventory_slots`; because that
///     value is non-zero, an absent or empty vector is a protocol error
///   - an empty slot is exactly `(0, 0)`: item id 0 is reserved for no item, and
///     neither `(0, nonzero)` nor `(nonzero, 0)` is legal
///   - an item id may appear in more than one slot; slot position, not item id,
///     identifies a stack
///
/// **Durability rides in two parallel vectors rather than inside `stacks`.** The pair
/// encoding above is append-only like every other field here, so it could not grow a
/// third scalar per slot without changing the meaning of every index already on the
/// wire. Two more slot-indexed vectors leave the existing pairs untouched, and they
/// let a client draw a durability ratio without owning an item-stat registry: the
/// maximum arrives beside the current value, so nothing has to be looked up.
///
/// Further invariants a decoder must enforce, for `durability[i]` and
/// `max_durability[i]` describing slot `i`:
///   - each vector holds exactly `ServerWelcome.inventory_slots` entries, the same
///     count as `stacks` holds pairs
///   - `(0, 0)` is a slot holding nothing, or holding something that does not wear
///     out; a resource stack is always exactly this
///   - otherwise `max_durability` is non-zero, `durability` is at most
///     `max_durability`, the slot's item id is non-zero, and its count is exactly 1 —
///     a durable item is a single whole item that never stacks or splits
///   - a `durability` of zero under a non-zero `max_durability` is **legal** and means
///     the item is worn out: unusable, still carried, still in its slot. Zero
///     durability is not an empty slot and never becomes one
table InventoryState {
  stacks: [ushort];

  /// Current durability per slot, slot-indexed. See the invariants above.
  durability: [ushort];

  /// Maximum durability per slot, slot-indexed. Zero means the slot's contents do not
  /// wear out at all, which is every resource and every empty slot.
  max_durability: [ushort];
}

/// What one player entity looks like and is called. **Server -> client, and static per
/// character.**
///
/// Sent once, when a player enters this session's view, and cached by the client
/// against the entity id for as long as the entity is known. It is not resent every
/// tick and it is not part of a snapshot.
///
/// **Why this is a message and not a field of `EntityState`.** `EntityState` is a
/// struct, so a snapshot's entity list is a flat inlined array — the most frequently
/// sent payload in the game, once per visible entity per tick. Five colours and a
/// hair model are *static per character*: they are chosen once, at creation, and then
/// never change for the life of that character. Putting them in the hot struct would
/// pay for them at the tick rate, for every visible player, for ever, to carry a
/// value that is identical in every frame. The character's name follows the same
/// lifetime and would be still more expensive there. It would also make `EntityState` a
/// different size, and a struct's field list can never be taken back.
///
/// **An appearance for an entity the client has never seen is not an error.** The two
/// streams are not ordered against each other: appearance is sent per entity as it
/// comes into view, snapshots are sent per tick, and either can arrive first. A
/// client that refused an appearance for an unknown id would drop exactly the
/// message it is about to need, and one that refused a *snapshot* naming an entity it
/// has no appearance for would refuse the ordinary case. So both are legal, in both
/// orders, and a receiver holds whichever half arrived first.
///
/// **The documented placeholder.** An entity the client can see but has no appearance
/// for yet is drawn in a **neutral grey** — every colour `0x808080` and
/// `HairModel.Shaved` — and redrawn as soon as the appearance arrives. That is a
/// rendering rule, not a decoding default: it applies only to an appearance that has
/// not arrived, never to one that arrived incomplete. An `Appearance` that is present
/// but breaks an invariant is refused, exactly as `common.fbs` says, because the
/// client may not invent what the server did describe.
///
/// Decoder invariants:
///   - `entity_id` is never 0, which names no entity anywhere in this contract
///   - `appearance` is present and satisfies every invariant `Appearance` documents
///   - `name` is present. It may be empty or arbitrarily long: this message carries the
///     stored display text verbatim, and a renderer must bound its layout rather than
///     changing what names the server accepts. It is never parsed or used as identity
///   - `level` is never zero
///   - `worn_head`, `worn_chest`, `worn_legs` and `worn_offhand` are item ids, with zero
///     meaning that the corresponding equipment slot is empty
///   - nothing here is required to name an entity in any snapshot, in either
///     direction; see above
table PlayerAppearance {
  /// The entity this appearance belongs to, matching `EntityState.entity_id` in the
  /// snapshots that carry that entity. A session's own appearance arrives the same
  /// way as everyone else's — `ServerWelcome.entity_id` is how it recognises itself.
  entity_id: ulong;

  /// What that player looks like. See `Appearance` in `common.fbs`, which is
  /// authoritative for the colour encoding.
  appearance: Appearance;

  /// The character's stored name, from the server and from nothing this session said.
  /// Display text only: shown, never parsed, and never used as an identifier — that is
  /// what `entity_id` is for.
  name: string;

  /// The sender's current level. Never zero. V17 sends it when the entity enters view;
  /// invalidating the cached appearance and resending it when the level changes is
  /// planned separately.
  level: ushort;

  /// Item id in the trailing head equipment slot, or zero when nothing is worn.
  worn_head: ushort;

  /// Item id in the trailing chest equipment slot, or zero when nothing is worn.
  worn_chest: ushort;

  /// Item id in the trailing legs equipment slot, or zero when nothing is worn.
  worn_legs: ushort;

  /// Item id in the trailing off-hand equipment slot, or zero when nothing is held.
  worn_offhand: ushort;
}
