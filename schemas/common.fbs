// =============================================================================
// common.fbs — primitives shared by every Voxelheim wire message.
//
// Included by every other contract file. Holds nothing that is specific to a
// single message, so a change here is a change to the whole protocol: treat it
// with the care that implies.
// =============================================================================

namespace Voxelheim.Net;

/// Wire protocol version, checked during the handshake.
///
/// FlatBuffers has no constants, so the current version is exposed as an enum
/// value that both generated APIs can read (`ProtocolVersionCurrent` in Go,
/// `ProtocolVersion::Current` in Rust). Bump it whenever a message changes in a
/// way an older peer cannot parse; a mismatch is rejected at the handshake
/// rather than discovered as a decode error mid-session.
enum ProtocolVersion : ushort {
  /// Never sent deliberately. A FlatBuffers table field that is absent decodes
  /// as its type's zero value, so this member exists to make that case fail
  /// closed: a `ClientHello` carrying no version at all reads as `Unknown` and
  /// is rejected, instead of defaulting to "whatever is current".
  Unknown = 0,

  Current = 7
}

/// A position, velocity or direction in world space, measured in blocks.
///
/// A struct, not a table: it is fixed-size, always present when used, and sits
/// on the hot path (every entity in every snapshot carries two of them), so it
/// must be inlined rather than reached through an offset.
struct Vec3 {
  x: float;
  y: float;
  z: float;
}

/// A chunk's address in chunk units. Multiply by `ServerWelcome.chunk_size` to
/// get the world-space origin of the chunk's minimum corner.
///
/// Chunks are cubic and addressed on all three axes — the vertical axis is
/// chunked like the others, so wards and world regeneration can reason about
/// volumes rather than whole columns.
struct ChunkCoord {
  cx: int;
  cy: int;
  cz: int;
}

/// Which hair a character wears, as a model this client is expected to have.
///
/// A vocabulary rather than a description: the server stores the member and never
/// draws anything, and the client maps it to a mesh. That is why hair is a member
/// here and every other part of an `Appearance` is a colour — a colour is a value
/// both sides can carry without agreeing on any asset, and a shape is not.
///
/// Zero member for the reason every enum in this contract has one: FlatBuffers
/// decodes an absent scalar as zero, and `Appearance` is explicitly a thing the
/// client may not invent a default for. An appearance carrying no hair model must
/// therefore fail closed rather than read as a bald head somebody did not choose.
///
/// **Members are appended, never inserted or renumbered**, exactly as `MobKind`'s
/// and `RecipeID`'s are: the value is an integer on the wire, so a renumbering
/// would silently put a different head on every character already stored.
///
/// The five below are reserved before anything depends on them, which is the call
/// `StructureKind.Campfire` and `RefusedAction` both record: agreeing on a number
/// is cheap now and expensive once a character store holds it.
enum HairModel : ubyte {
  Unknown = 0,
  Shaved = 1,
  Cropped = 2,
  Braided = 3,
  Loose = 4,
  Topknot = 5
}

/// What a character looks like: four worn colours, a hair model, and its colour.
///
/// **Authoritative, and the client never invents a default.** Every value here was
/// chosen by the player and stored by the server; a client that substituted its own
/// colour for a missing one would draw somebody the server never described. An
/// absent `Appearance` and an `Unknown` hair model are both protocol errors at the
/// decode boundary, not opportunities to guess. The one documented placeholder in
/// this contract is a different case entirely — an entity whose `PlayerAppearance`
/// has not arrived *yet*; see `player.fbs`.
///
/// **An absent colour is deliberately not on that list, and the reason is written
/// here so nobody adds it back.** A table scalar carries no presence bit: FlatBuffers
/// writes no bytes for a field equal to its default, and `0x000000` — black — is a
/// colour a player may legitimately choose. Absent and black are therefore the same
/// bytes on the wire, so a decoder that refused absence would refuse a character
/// wearing black shoes, and an encoder would have to be told to write defaults it
/// otherwise omits. The claim this contract can keep is the narrower one: the wire
/// could never distinguish an omitted colour from a chosen black one, exactly as it
/// cannot distinguish a wrong colour from a right one. What a decoder *can* hold is
/// that every value it accepts is one the peer could have meant — which is what the
/// invariants below are.
///
/// **A table rather than a struct**, deliberately, and against the rule of thumb
/// that fixed-size shapes are inlined. A struct can never gain, lose or reorder a
/// field, and this shape is the least settled in the contract: beards, faces, body
/// types and worn equipment are all things a later issue adds. It is also not hot —
/// see `PlayerAppearance` in `player.fbs`, which is why appearance is a message of
/// its own rather than a field of `EntityState`.
///
/// **Colour encoding — stated once, here, and authoritative for every colour on
/// this wire.** Each colour is one `uint` holding `0x00RRGGBB`: eight bits per
/// channel, sRGB, non-linear, with the most significant eight bits **reserved and
/// required to be zero**. There is no alpha — a character is opaque — and there is
/// no second encoding anywhere in this contract, so neither side needs a conversion
/// rule to agree on. A client whose renderer wants linear values converts on the way
/// in; that is a rendering detail and not a property of the wire.
///
/// Decoder invariants:
///   - every colour's top eight bits are zero. Refused rather than masked: a set
///     high byte means the peer is encoding something this build does not know
///     about, and masking it would show a colour nobody chose while hiding the
///     disagreement — the reasoning `ServerWelcome`'s world clock records, where a
///     repair a decoder invents is a different answer from the server's
///   - `hair_model` is a known member and never `Unknown`
///   - the table itself is present wherever it is referenced
///
/// **Which side refuses, and where, is not symmetric — and the asymmetry is the one
/// `CraftRequest` already records.** A client reads its authority; a server reads
/// untrusted input.
///
/// On the **client** these are decode errors: a server that sends a colour this
/// contract forbids is a server this client cannot go on talking to, and the session
/// ends rather than drawing somebody nobody described.
///
/// On the **server** they are refusals *above* the envelope, not framing errors.
/// `internal/protocol` owns the envelope, and a colour it dislikes arrives inside a
/// frame that is perfectly readable — closing the connection over it would answer a
/// value question with a framing verdict, which is precisely what `CraftRequest` says
/// not to do when an unknown recipe arrives. **The obligation that follows is
/// explicit, and belongs to whatever accepts a `CreateCharacterRequest`: an
/// appearance that breaks these invariants must be refused before it is stored.** A
/// character persisted with `hair_model = 200` or a colour carrying a reserved high
/// byte is one every client will afterwards refuse to load, and the person who cannot
/// get in is not the person who sent it.
table Appearance {
  /// Skin.
  skin_color: uint;

  /// The shirt, tunic or coat covering the torso.
  shirt_color: uint;

  /// The trousers, breeches or leggings covering the legs.
  trousers_color: uint;

  /// Footwear.
  shoes_color: uint;

  /// Which hair model the character wears. Never `Unknown` in a value the server
  /// emits or accepts.
  hair_model: HairModel;

  /// The hair's colour, in the same encoding as the four above. Read whatever the
  /// model is: a shaved head still has stubble, and the client decides how much of
  /// the colour a given model shows.
  hair_color: uint;
}
