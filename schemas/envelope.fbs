// =============================================================================
// envelope.fbs — the single root type on the wire.
//
// Every frame on a Voxelheim connection is exactly one Envelope. There is one
// root type and one union, so both sides have exactly one decode entry point
// and one switch to keep exhaustive.
// =============================================================================

include "handshake.fbs";
include "world.fbs";
include "player.fbs";

namespace Voxelheim.Net;

/// Every message that can cross the wire, in both directions.
///
/// Direction is a protocol rule rather than a type-system one: a peer that
/// receives a payload it should never receive (a server receiving
/// `ServerWelcome`, a client receiving `PlayerInput`) treats it as a protocol
/// error and closes the connection.
///
/// Union members are append-only. Adding a member is backward compatible;
/// reordering or removing one is a protocol version bump.
///
/// The tag each member carries is written beside it. FlatBuffers numbers union
/// members implicitly, from 1, in declaration order — so a reordering compiles
/// perfectly and silently changes the meaning of every frame already on the
/// wire. It is the one mistake in this file no compiler can catch, and the
/// comments are here so a reviewer can read the tags instead of counting them.
union Payload {
  ClientHello,      // 1
  ServerWelcome,    // 2
  ServerReject,     // 3
  ChunkData,        // 4
  ChunkUnload,      // 5
  PlayerInput,      // 6
  EntitySnapshot,   // 7
  BlockEditRequest, // 8
  BlockUpdate,      // 9
  InventoryState,         // 10
  ChunkResendRequest,     // 11
  MineRequest,            // 12
  MineProgress,           // 13
  InventoryMoveRequest,   // 14
  AttackRequest,          // 15
  CraftRequest,           // 16
  RepairRequest,          // 17
  PlaceStructureRequest,  // 18
  RemoveStructureRequest, // 19

  /// Appended without a version bump, which is what the append-only rule above is
  /// *for*. A peer built against V6 as it shipped reads this tag as a payload it has
  /// no name for and drops it, so an older client loses the refusal feedback and
  /// nothing else. See `ActionRefused` in `player.fbs`.
  ActionRefused,          // 20

  // -- V7. Appended, like everything above them, so the tags of 1..20 are untouched.
  //
  //    **These four do carry a version bump, and `ActionRefused` did not.** The
  //    difference is not the number of members added, it is what an older peer loses
  //    by dropping them. A dropped `ActionRefused` costs a player one explanation.
  //    Three of these four are the handshake itself: a V6 client dropping
  //    `ServerCharacterList` never chooses a character and never receives a welcome,
  //    so it waits for ever on a phase it has no name for. That is precisely the
  //    "discovered as a decode error mid-session" failure `ProtocolVersion` exists to
  //    turn into a clean refusal at the handshake.
  //
  //    The first three are the new handshake phase, in the order it runs; the fourth
  //    is the in-world half. See `handshake.fbs` and `player.fbs`.

  ServerCharacterList,    // 21
  SelectCharacterRequest, // 22
  CreateCharacterRequest, // 23
  PlayerAppearance,       // 24

  // -- V8. Appended, so the tags of 1..24 are untouched.
  //
  //    **It carries a version bump, and the direction is the whole reason.** "What does an
  //    older peer lose by dropping this tag" has a different answer depending on which peer
  //    is the older one. A *client* drops what it cannot name and carries on — that is
  //    `ActionRefused`, and it cost a player one explanation. A **server** does not drop:
  //    direction is a protocol rule, an unrecognised payload is a protocol error, and the
  //    session is closed. So a V7 server and a V8 client would handshake cleanly and end
  //    the connection on the first stack anybody put down, which is the "discovered as a
  //    decode error mid-session" failure `ProtocolVersion` exists to prevent.
  //
  //    That is the consistent line rather than a new one: every client→server member this
  //    union has gained arrived with a bump, and the one appended without one travels the
  //    other way. See `DropItemRequest` in `player.fbs`.

  DropItemRequest,        // 25

  // -- V12. Appended, so the tags of 1..25 are untouched.
  //
  //    The request carries the bump. An older server refuses a client payload it
  //    cannot name, so a V12 client must not handshake with one and then discover the
  //    mismatch only when leaving. The acknowledgement is the authoritative duration
  //    that client presentation counts down; socket closure remains the completion.
  LeaveRequest,           // 26
  LeaveStarted,           // 27

  // -- V15. A client request, and therefore a bump owed: a V14 server cannot name
  //    this tag and closes the session rather than dropping it.
  ConsumeRequest,         // 28

  // -- V20. Appended, so the tags of 1..28 are untouched.
  //
  //    The two requests carry the bump: an older server cannot name either client
  //    payload and closes the session rather than dropping it, so a V20 client must
  //    not discover that mismatch only when somebody chats or asks for a party.
  //    The two server messages are their event counterparts and remain append-only.
  ChatRequest,            // 29
  ChatMessage,            // 30
  PartyRequest,           // 31
  PartyInvite,            // 32

  // -- V21. Appended, so the tags of 1..32 are untouched.
  //
  //    The requests carry the bump: an older server cannot name either client payload
  //    and closes the session instead of dropping it. The two server messages are the
  //    complete per-recipient answer and its explicit end marker.
  LootOpenRequest,        // 33
  LootTakeRequest,        // 34
  LootState,              // 35
  LootClosed,             // 36

  // -- Optional server-to-client presentation feedback. An older client drops
  //    the whole tag safely; a newer client against an older server receives no
  //    pulse. Existing tags remain untouched, so no protocol-version bump is owed.
  MobHit,                  // 37

  // -- V22. Appended, so the tags of 1..37 are untouched.
  //
  //    Client -> server intent. An older server cannot name this payload and closes
  //    the session rather than dropping it, so the V22 protocol bump is owed.
  BlockRequest,            // 38

  // -- V23. Appended, so the tags of 1..38 are untouched.
  //
  //    Client -> server intent: take everything in a corpse that fits. An older server
  //    cannot name this payload and closes the session rather than dropping it, so the
  //    V23 protocol bump is owed. The answer reuses LootState, LootClosed and
  //    ActionRefused, so nothing server -> client is added here.
  LootTakeAllRequest,      // 39

  // -- V24. Appended, so the tags of 1..39 are untouched.
  //
  //    The map, in one contract change rather than six. Three of these travel
  //    client -> server and each owes the bump on its own: an older server cannot name
  //    the tag and closes the session rather than dropping it, so a V24 client would
  //    handshake cleanly and lose the connection the first time somebody opened the map
  //    or put a pin in it. The other three travel back and would have owed nothing
  //    alone — `MapTile` answers a request, `MapExplored` is a ledger page, `MarkerList`
  //    is the complete list a place or a removal is answered with.
  //
  //    They are appended together because the alternative is three bumps for one
  //    feature, and because the server and client issues that follow this one all read
  //    these tags. See `world.fbs` for the tile and the ledger, `player.fbs` for the
  //    marks.

  MapTileRequest,          // 40  client -> server
  MapTile,                 // 41  server -> client
  MapExplored,             // 42  server -> client
  MarkerPlaceRequest,      // 43  client -> server
  MarkerRemoveRequest,     // 44  client -> server
  MarkerList,              // 45  server -> client

  // -- V25. Appended, so the tags of 1..45 are untouched.
  //
  //    The settlement, in one contract change rather than three. Two of these travel
  //    client -> server and each owes the bump on its own: an older server cannot name
  //    the tag and closes the session rather than dropping it, so a V25 client would
  //    handshake cleanly and lose the connection the first time somebody spoke to a
  //    resident or bought anything. The other three travel back and would have owed
  //    nothing alone — `ResidentAppearance` is a name and a role sent once as the entity
  //    enters view, `VendorState` is the complete price list, `VendorClosed` its explicit
  //    end marker.
  //
  //    The bump is owed a third time from outside this union: `MobKind.Villager` is an
  //    enum member both decoders refuse rather than drop. See `common.fbs`.
  //
  //    They are appended together because the alternative is three bumps for one feature,
  //    and because the server and client issues that follow this one all read these tags.
  //    See `player.fbs` for every table named here.

  ResidentAppearance,      // 46  server -> client
  NpcInteractRequest,      // 47  client -> server
  VendorState,             // 48  server -> client
  TradeRequest,            // 49  client -> server
  VendorClosed,            // 50  server -> client

  // -- V26. Appended, so the tags of 1..50 are untouched.
  //
  //    The Fimbulvetr's two messages, and **neither of them is why V26 exists**. Both
  //    travel server -> client, so an older client drops a tag it cannot name and loses
  //    a warning or some shading; on the rule this file states, that is a bump avoided
  //    rather than one owed. The break is elsewhere — `StructureKind.Runestone` is an
  //    enum member a receiver *refuses* — and it is recorded in `common.fbs`.
  //
  //    They are appended together with it for the reason every batch above was: the
  //    weather, the storm and the runestone are one iteration, and the server and client
  //    issues that follow all read this one settled contract instead of moving the
  //    version three more times. See `player.fbs` for both tables.

  StormWarning,            // 51  server -> client
  WardsNearby,             // 52  server -> client

  // -- V27. Appended, so the tags of 1..52 are untouched.
  //
  //    The request carries the bump: an older server cannot name this client payload
  //    and closes the session instead of dropping it. The result is the authoritative
  //    answer; an older client would safely drop that server payload, but it could never
  //    send the request that causes one.
  LeaveCancelRequest,      // 53  client -> server
  LeaveCancelResult,       // 54  server -> client

  //    The stable contract shares this bump. Both requests travel client -> server,
  //    so an older server closes the session on either unknown tag. LearnedMounts is
  //    the complete per-recipient set and would be safely droppable by an older client;
  //    `MobKind.Horse`, outside this union, independently owes the same bump.
  LearnedMounts,           // 55  server -> client
  MountRequest,            // 56  client -> server
  DismountRequest,         // 57  client -> server

  // -- V28. Appended, so the tags of 1..57 are untouched.
  //
  //    PlayerTradeRequest carries the bump: a V27 server cannot name this client
  //    payload and closes the session instead of dropping it. The complete two-sided
  //    state and explicit close ride in the same bump so every player-trading consumer
  //    builds against one settled contract.
  PlayerTradeRequest,      // 58  client -> server
  PlayerTradeState,        // 59  server -> client
  PlayerTradeClosed        // 60  server -> client
}

table Envelope {
  payload: Payload;
}

root_type Envelope;

/// Four-byte tag at a fixed offset in every buffer. Cheap sanity check that a
/// frame is a Voxelheim message at all, before any offset in it is trusted.
file_identifier "VXLH";
